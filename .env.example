GEMINI_API_KEY=
GEMINI_MODELS=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_VENDOR_EMAILS=
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=
DATABASE_URL=file:./dev.db
# Minutes a changed demo may sit idle before the next visit resets it to the seed (default 30; 0 = never)
DEMO_AUTO_RESET_MINUTES=
# Sign-in (Auth.js). AUTH_SECRET signs the session cookie: generate one with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Google sign-in is optional: without these two, only email + password is offered. See the README's Accounts section.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The site's public URL (https://vowlet.onrender.com on Render). Not needed for localhost.
AUTH_URL=
